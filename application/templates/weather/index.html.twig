{% extends 'base.html.twig' %}

{% block title %}Выбор города{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-100 to-blue-300 p-6">
        <div class="bg-white shadow-lg rounded-xl p-8 w-full max-w-md">
            <h1 class="text-2xl font-semibold mb-6 text-center text-blue-700">Узнать погоду</h1>
            <form method="get" action="{{ path('weather_show', {'city': ''}) }}" onsubmit="this.action=this.action + this.city.value;">
                <input
                        type="text"
                        name="city"
                        placeholder="Введите город..."
                        required
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-400"
                >
                <button
                        type="submit"
                        class="mt-4 w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-md transition">
                    Показать погоду
                </button>
            </form>
        </div>
    </div>
{% endblock %}
